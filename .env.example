# Local PostgreSQL Settings
DB_HOST=db
DB_PORT=5432
DB_NAME=ledgerly_db
DB_USER=ledgerly
DB_PASSWORD=ledgerly_local_sec_pass

# Local vLLM Inference Engine
# Note: Use http://host.docker.internal:8000/v1 when vLLM runs on the host machine
VLLM_HOST=http://host.docker.internal:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct